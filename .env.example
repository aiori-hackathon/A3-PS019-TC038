# Copy to .env (never commit .env) or set these in your host's secret/environment settings.

# --- Backend (FastAPI) ---
# Gemini API key from https://aistudio.google.com/apikey. Optional: scanning and manual review work without it.
GEMINI_API_KEY=
# Preferred model. If it is unavailable for the key or out of quota, the server lists the key's
# available Gemini text models (GET /api/ai/models) and tries the next suitable one.
GEMINI_MODEL=gemini-3.1-flash-lite
# Maximum models tried per batch before the run pauses.
GEMINI_MAX_MODEL_ATTEMPTS=4
# SQLite workspace path. Put it on a persistent volume in production (uploads are stored beside it).
PRIVACYTWIN_DB=/data/workspace.sqlite3
# Optional: where GET / on the backend redirects (the public URL of the web UI).
PRIVACYTWIN_WEB_URL=

# --- Frontend (Next.js) ---
# Backend address used by the /api proxy. Required at BUILD time for production builds.
PRIVACYTWIN_API_URL=http://backend:8000
