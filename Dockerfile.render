# Single-container PrivacyTwin for Render's free plan (one public web service).
# The Next.js frontend is built as static files and served by the FastAPI app on the same
# address, so the browser calls /api on its own origin.

# --- Build the static web UI ---
FROM node:22-slim AS web
WORKDIR /app
COPY eval/results.json eval/results.json
COPY web/package.json web/package-lock.json web/
RUN cd web && npm ci --no-audit --no-fund
COPY web/ web/
ENV NEXT_PUBLIC_API_URL=same-origin NEXT_TELEMETRY_DISABLED=1
RUN cd web && npm run build

# --- Runtime: Python API + static files ---
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PRIVACYTWIN_STATIC_DIR=/app/web/out PRIVACYTWIN_DB=/app/data/privacytwin.sqlite3 PORT=10000
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY privacytwin ./privacytwin
COPY eval ./eval
COPY --from=web /app/web/out ./web/out
RUN useradd --create-home app && mkdir -p data && chown -R app:app /app/data
USER app
EXPOSE 10000
CMD ["sh", "-c", "exec uvicorn privacytwin.api:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --forwarded-allow-ips='*'"]
