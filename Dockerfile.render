# Single-container PrivacyTwin for Render's free plan (one web service, no private network).
# The API listens only inside the container; Next.js is the only public port and proxies /api to it.

# --- Build the web UI ---
FROM node:22-slim AS web
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
# Same container, so the API is on the container's own loopback interface.
ENV PRIVACYTWIN_API_URL=http://127.0.0.1:8000 NEXT_TELEMETRY_DISABLED=1
RUN npm run build && npm prune --omit=dev

# --- Runtime: Python API + Node web server ---
FROM python:3.12-slim
COPY --from=web /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    PRIVACYTWIN_API_URL=http://127.0.0.1:8000 PRIVACYTWIN_DB=/app/data/workspace.sqlite3 PORT=10000
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY main.py ./
COPY core ./core
COPY --from=web /app/web/package.json ./web/
COPY --from=web /app/web/next.config.ts ./web/
COPY --from=web /app/web/node_modules ./web/node_modules
COPY --from=web /app/web/.next ./web/.next
COPY --from=web /app/web/public ./web/public
COPY deploy/start.sh ./start.sh
RUN chmod +x start.sh && useradd --create-home app && mkdir -p data && chown -R app:app /app/data /app/web/.next
USER app
EXPOSE 10000
CMD ["./start.sh"]
